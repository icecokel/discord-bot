[Unit]
Description=Discord Bot on OCI
Wants=network-online.target
After=network-online.target
ConditionPathExists=/srv/discord-bot/.local/activate-oci
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=discord-bot
Group=discord-bot
WorkingDirectory=/srv/discord-bot
Environment=NODE_ENV=production
Environment=PROCESS_MANAGER=systemd
Environment=PLAYWRIGHT_BROWSERS_PATH=/srv/discord-bot/.local/ms-playwright
Environment=TMPDIR=/srv/discord-bot/.local/tmp
Environment=XDG_CACHE_HOME=/srv/discord-bot/.local/cache
ExecStartPre=/usr/bin/test -f /srv/discord-bot/.env
ExecStartPre=/usr/bin/test -d /srv/discord-bot/dist/data
ExecStartPre=/usr/bin/test -d /srv/discord-bot/.local/ms-playwright
ExecStart=/usr/bin/xvfb-run -a /srv/discord-bot/.local/node/bin/node /srv/discord-bot/dist/index.js
Restart=always
RestartSec=10
KillMode=control-group
TimeoutStopSec=150
UMask=0077

[Install]
WantedBy=multi-user.target
